{
  "manifest_version": 3,
  "name": "Tab Info Exporter",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "Выгрузка списка всех вкладок (название, ссылка, даты) в CSV или JSON через буфер обмена или файл.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Info Exporter",
    "default_icon": {
      "48": "icons/icon-48.ico",
      "96": "icons/icon-96.ico",
      "128": "icons/icon-128.ico"
    }
  },
  "icons": {
    "48": "icons/icon-48.ico",
    "96": "icons/icon-96.ico",
    "128": "icons/icon-128.ico"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-info-exporter@local"
    }
  },
  "permissions": ["tabs", "storage", "downloads", "clipboardWrite"]
}
